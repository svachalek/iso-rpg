; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Iso"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cam_right={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
cam_up={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
cam_forward={
"type": "vec3",
"value": Vector3(0, 0, -1)
}
sun_forward={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
cutout_enabled={
"type": "float",
"value": 0.0
}
occluder_a={
"type": "vec4",
"value": Vector4(1, 1, 0, 0)
}
occluder_b={
"type": "vec4",
"value": Vector4(1, 1, 0, 0)
}
occluder_c={
"type": "vec4",
"value": Vector4(1, 1, 0, 0)
}
occluder_strength={
"type": "float",
"value": 0.0
}
occluder_upper={
"type": "float",
"value": 100000.0
}
own_building={
"type": "vec4",
"value": Vector4(1, 1, 0, 0)
}
cutout_floor={
"type": "float",
"value": 100000.0
}
material_map={
"type": "sampler2D",
"value": ""
}
blend_enabled={
"type": "float",
"value": 1.0
}
slice_height={
"type": "float",
"value": 100000.0
}
slice_strength={
"type": "float",
"value": 0.0
}
slice_radius={
"type": "float",
"value": 9.0
}
underground={
"type": "float",
"value": 0.0
}
